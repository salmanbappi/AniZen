import kotlin.Boolean;

CREATE TABLE extension_repos (
    base_url TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    short_name TEXT,
    website TEXT NOT NULL,
    signing_key_fingerprint TEXT NOT NULL,
    is_visible INTEGER AS Boolean NOT NULL DEFAULT 1,
    author TEXT,
    discord TEXT,
    icon TEXT,
    is_legacy INTEGER AS Boolean NOT NULL DEFAULT 1,
    extension_list_url TEXT
);

contains:
SELECT EXISTS(SELECT 0 FROM extension_repos WHERE base_url = :base_url);

findOne:
SELECT *
FROM extension_repos
WHERE base_url = :base_url;

findAll:
SELECT *
FROM extension_repos;

count:
SELECT COUNT(*)
FROM extension_repos;

insert:
INSERT INTO extension_repos(base_url, name, short_name, website, signing_key_fingerprint, is_visible, author, discord, icon, is_legacy, extension_list_url)
VALUES (:base_url, :name, :short_name, :website, :fingerprint, :is_visible, :author, :discord, :icon, :is_legacy, :extension_list_url);

upsert:
INSERT INTO extension_repos(base_url, name, short_name, website, signing_key_fingerprint, is_visible, author, discord, icon, is_legacy, extension_list_url)
VALUES (:base_url, :name, :short_name, :website, :fingerprint, :is_visible, :author, :discord, :icon, :is_legacy, :extension_list_url)
ON CONFLICT(base_url)
DO UPDATE
SET
    name = excluded.name,
    short_name = excluded.short_name,
    website = excluded.website,
    signing_key_fingerprint = excluded.signing_key_fingerprint,
    is_visible = excluded.is_visible,
    author = excluded.author,
    discord = excluded.discord,
    icon = excluded.icon,
    is_legacy = excluded.is_legacy,
    extension_list_url = excluded.extension_list_url;

delete:
DELETE FROM extension_repos
WHERE base_url = :base_url;

updateVisibility:
UPDATE extension_repos
SET is_visible = :is_visible
WHERE base_url = :base_url;